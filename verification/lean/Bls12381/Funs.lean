  let (r1, carry) ← util.mac 0#u64 i i1 0#u64
  let i2 ← Array.index_usize self 2#usize
  let (r2, carry1) ← util.mac 0#u64 i i2 carry
  let i3 ← Array.index_usize self 3#usize
  let (r3, r4) ← util.mac 0#u64 i i3 carry1
  let (r31, carry2) ← util.mac r3 i1 i2 0#u64
  let (r41, r5) ← util.mac r4 i1 i3 carry2
  let (r51, r6) ← util.mac r5 i2 i3 0#u64
  let r7 ← r6 >>> 63#i32
  let i4 ← r6 <<< 1#i32
  let i5 ← r51 >>> 63#i32
  let r61 ← lift (i4 ||| i5)
  let i6 ← r51 <<< 1#i32
  let i7 ← r41 >>> 63#i32
  let r52 ← lift (i6 ||| i7)
  let i8 ← r41 <<< 1#i32
  let i9 ← r31 >>> 63#i32
  let r42 ← lift (i8 ||| i9)
  let i10 ← r31 <<< 1#i32
  let i11 ← r2 >>> 63#i32
  let r32 ← lift (i10 ||| i11)
  let i12 ← r2 <<< 1#i32
  let i13 ← r1 >>> 63#i32
  let r21 ← lift (i12 ||| i13)
  let r11 ← r1 <<< 1#i32
  let (r0, carry3) ← util.mac 0#u64 i i 0#u64
  let (r12, carry4) ← util.adc 0#u64 r11 carry3
  let (r22, carry5) ← util.mac r21 i1 i1 carry4
  let (r33, carry6) ← util.adc 0#u64 r32 carry5
  let (r43, carry7) ← util.mac r42 i2 i2 carry6
  let (r53, carry8) ← util.adc 0#u64 r52 carry7
  let (r62, carry9) ← util.mac r61 i3 i3 carry8
  let (r71, _) ← util.adc 0#u64 r7 carry9
  scalar.Scalar.montgomery_reduce r0 r12 r22 r33 r43 r53 r62 r71

